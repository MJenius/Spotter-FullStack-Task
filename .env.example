# ---------- Backend-only (NEVER expose to the browser) ----------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Server-side Google Routes API key. Do NOT prefix with VITE_.
GOOGLE_ROUTES_API_KEY=your-google-routes-api-key
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=1800
PROVIDER_TIMEOUT_SECONDS=15

# ---------- Frontend-public (bundled into JS; put in frontend/.env.local) ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
